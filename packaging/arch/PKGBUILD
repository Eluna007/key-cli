# Build from the local source archive prepared by scripts/build-packages.sh.
pkgbase=key-cli
pkgname=(key-cli key-cli-keyboard-access)
pkgver=0.2.0
pkgrel=1
pkgdesc='Clavis command interface, clipboard backend and keyboard LED events'
arch=('any')
url='https://github.com/StatIndet/key-cli'
license=('GPL-3.0-or-later')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-evdev' 'python-pyudev')
source=("key-cli-${pkgver}.tar.gz")
# Local checkout snapshot, never fetched from an unverified release URL.
sha256sums=('SKIP')

build() {
    cd "${srcdir}/key-cli-${pkgver}"
    python -m build --wheel --no-isolation
}

check() {
    cd "${srcdir}/key-cli-${pkgver}"
    PYTHONPATH=src python -m pytest
    python scripts/check-wheel.py dist/*.whl
}

package_key-cli() {
    depends=('python' 'python-evdev' 'python-pyudev' 'cliphist' 'wl-clipboard')
    optdepends=('key-cli-keyboard-access: grant active local users keyboard device access'
                'quickshell: Clavis shell and IPC' 'gpu-screen-recorder: screen recording'
                'ffmpeg: audio and GIF processing' 'libpulse: audio source discovery'
                'slurp: region selection'
                'xdg-utils: open saved files and query the default file manager'
                'xdg-terminal-exec: launch terminal file managers such as Yazi')
    cd "${srcdir}/key-cli-${pkgver}"
    python -m installer --destdir="${pkgdir}" --prefix=/usr dist/*.whl
    install -Dm644 systemd/user/clavis-clipboard.service "${pkgdir}/usr/lib/systemd/user/clavis-clipboard.service"
    install -Dm644 completions/key.fish "${pkgdir}/usr/share/fish/vendor_completions.d/key.fish"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli/installation.md"
}

package_key-cli-keyboard-access() {
    pkgdesc='Optional evdev keyboard access for active local users (not LED-only access)'
    depends=('systemd')
    cd "${srcdir}/key-cli-${pkgver}"
    install -Dm644 packaging/udev/71-clavis-keyboard-leds.rules "${pkgdir}/usr/lib/udev/rules.d/71-clavis-keyboard-leds.rules"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli-keyboard-access/installation.md"
}
