# shellcheck shell=bash disable=SC2034,SC2154
# Generated by scripts/release.py; dependencies come from packaging/dependencies.json.
pkgbase=key-cli
pkgname=('key-cli' 'key-cli-keyboard-access')
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Clavis command interface, clipboard backend and keyboard events'
arch=('any')
url='https://github.com/StatIndet/key-cli'
license=('GPL-3.0-or-later')
# Pure Python and udev data contain no ELF debug symbols to split out.
options=('!debug')
makedepends=@MAKEDEPENDS@
checkdepends=@CHECKDEPENDS@
source=("key-cli-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/key-cli-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
    cd "key-cli-${pkgver}" || return
    python -m build --wheel --no-isolation
}

check() {
    cd "key-cli-${pkgver}" || return
    PYTHONPATH=src python -m pytest
    python scripts/check-wheel.py dist/*.whl
}

package_key-cli() {
    depends=@KEY_CLI_DEPENDS@
    optdepends=@KEY_CLI_OPTDEPENDS@
    cd "key-cli-${pkgver}" || return
    python -m installer --destdir="${pkgdir}" --prefix=/usr dist/*.whl
    install -Dm644 systemd/user/clavis-clipboard.service "${pkgdir}/usr/lib/systemd/user/clavis-clipboard.service"
    install -Dm644 completions/key.fish "${pkgdir}/usr/share/fish/vendor_completions.d/key.fish"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli/installation.md"
}

package_key-cli-keyboard-access() {
    pkgdesc='Optional whole evdev keyboard device access for active local users'
    depends=@KEY_CLI_KEYBOARD_ACCESS_DEPENDS@
    cd "key-cli-${pkgver}" || return
    install -Dm644 packaging/udev/71-clavis-keyboard-leds.rules "${pkgdir}/usr/lib/udev/rules.d/71-clavis-keyboard-leds.rules"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli-keyboard-access/installation.md"
}
